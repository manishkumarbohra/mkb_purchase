<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_merge_so_lines" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.so.lines</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="merge_duplicate_po_lines"
                        type="object"
                        string="Merge Duplicate PO Lines"
                        class="btn-secondary"
                        invisible="state != 'draft'"
                />
            </xpath>
        </field>
    </record>
</odoo>